#!/bin/sh
# Rueckfall ohne fest verdrahteten Pfad.
#
# Ein fest verdrahteter Systempfad ist aus zwei Gruenden falsch: LoxBerry laesst
# sich anderswohin installieren, und der Pluginpruefer beanstandet die
# Zeichenkette. Eine feste Anzahl von ".." waere nur die naechste Wette -
# je nachdem, wohin LoxBerry diese Datei bei der Installation legt, sind es
# drei oder vier Ebenen. Deshalb wird aufwaerts gesucht, bis ein
# Verzeichnis gefunden ist, das nachweislich eine LoxBerry-Wurzel ist:
# es traegt config/plugins, data/plugins UND config/system/general.json.
#
# Die dritte Bedingung steht seit 1.3.10 dabei und kommt aus Regeln/06: ein
# Ort mit config/plugins und data/plugins muss kein LoxBerry sein - auf einem
# Pruefrechner entsteht so etwas aus alten Prueflaeufen, und der Eichlauf
# eines anderen Plugins hat dort prompt geloescht. Ein LoxBerry hat immer
# config/system/general.json; ein solcher Rest hat sie nie. In WSL gemessen
# (17.09.2026, Fall q6): ohne die Bedingung entfernte dieses Skript an einem
# Ort ohne general.json die dortige dienst.pid, mit ihr bleibt sie liegen und
# es wird gewarnt.
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}
# Chromecast 4 Lox NG - Deinstallation
#
# Beendet werden ALLE Prozesse dieses Dienstes (cc_dienste_finden unten),
# nicht nur der aus der PID-Datei - und NICHT ueber pkill -f.
#
# pkill -f "chromecast4lox_ng-server" traf jeden Prozess, in dessen
# Kommandozeile die Zeichenkette irgendwo vorkam: einen Editor mit der
# geoeffneten Datei, ein tail auf einen Pfad mit diesem Namen. Beim Beenden
# ist das kein theoretisches Risiko - pkill schickt das Signal an ALLE
# Treffer. Die PID-Datei allein reicht aber auch nicht: purge_installation
# loescht sie beim Upgrade, und ein Dienst ohne sie lief bis 1.3.9 nach der
# Deinstallation weiter (in WSL nachgestellt am 17.09.2026).

BASE="${5:-$LBHOMEDIR}"
[ -n "$BASE" ] && [ -d "$BASE" ] || BASE=$(lb_wurzel_suchen)
PDIR="${3:-chromecast-4lox-ng}"

# Fail closed: sieht die Lage nicht wie ein LoxBerry aus, wird NICHTS
# geloescht und gesagt, wo von Hand nachzusehen ist (Regeln/06,
# "Das Deinstallationsskript ist fail-closed"). Geprueft wird auch der Weg
# ueber $5 und LBHOMEDIR - ein falscher Wert von aussen ist genauso
# gefaehrlich wie eine fehlgegangene Suche.
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] \
   || [ ! -f "$BASE/config/system/general.json" ]; then
    echo "<WARNING> Kein LoxBerry erkannt (config/system/general.json fehlt unter '$BASE')."
    echo "<WARNING> Es wurde nichts entfernt. Von Hand nachzusehen sind der Dienst"
    echo "<WARNING> chromecast4lox_ng-server.py, data/plugins/<ordner>.upgrade_sicherung,"
    echo "<WARNING> config/plugins/<ordner>.backup.chromecast-4lox-ng.cfg und"
    echo "<WARNING> data/plugins/<ordner>.upgrade_laeuft."
    exit 0
fi
PIDDATEI="$BASE/data/plugins/$PDIR/dienst.pid"

# ---------- Prozesse des Dienstes finden und beenden ----------
# Ein Treffer hat GENAU zwei Argumente: einen python-Interpreter und den
# vollen Dienstpfad DIESES Plugins ($1). Dazu muss der Prozess dem Benutzer
# mit der Nummer $2 gehoeren. Ein Editor oder "tail" auf die Datei, eine
# Suche mit dem Namen im Muster, der Selbsttest mit "--themen" und der
# Dienst eines anderen Plugin-Ordners treffen damit nicht. "pgrep -f" traf
# jede Befehlszeile, in der die Zeichenkette irgendwo vorkam.
cc_dienste_finden() {
    for cc_d in /proc/[0-9]*; do
        grep -qaF "chromecast4lox_ng-server.py" "$cc_d/cmdline" 2>/dev/null || continue
        [ "$(stat -c %u "$cc_d" 2>/dev/null)" = "$2" ] || continue
        cc_n=0
        cc_treffer=0
        while IFS= read -r cc_arg; do
            cc_n=$((cc_n + 1))
            if [ "$cc_n" = 1 ]; then
                case "${cc_arg##*/}" in
                    python|python3|python3.*) ;;
                    *) break ;;
                esac
            elif [ "$cc_n" = 2 ] && [ "$cc_arg" = "$1" ]; then
                cc_treffer=1
            fi
        done <<CC_ARGUMENTE
$(tr '\0' '\n' < "$cc_d/cmdline" 2>/dev/null)
CC_ARGUMENTE
        if [ "$cc_treffer" = 1 ] && [ "$cc_n" = 2 ]; then
            echo "${cc_d#/proc/}"
        fi
    done
}

# Beendet alle Treffer mit Geduld: TERM, bis zu zehn Sekunden warten, dann
# KILL fuer den Rest. Danach wird NEU gesucht, nicht angenommen.
# Ergebnis: CC_GEFUNDEN (Zahl der Treffer) und CC_UEBRIG (leer, wenn
# hinterher keiner mehr laeuft, sonst die Nummern).
cc_dienste_beenden() {
    CC_GEFUNDEN=0
    CC_UEBRIG=""
    cc_pids=$(cc_dienste_finden "$1" "$2")
    for cc_p in $cc_pids; do
        CC_GEFUNDEN=$((CC_GEFUNDEN + 1))
    done
    [ -n "$cc_pids" ] || return 0
    kill $cc_pids 2>/dev/null
    cc_i=0
    while [ $cc_i -lt 20 ]; do
        cc_lebt=0
        for cc_p in $cc_pids; do
            kill -0 "$cc_p" 2>/dev/null && cc_lebt=1
        done
        [ "$cc_lebt" = 0 ] && break
        sleep 0.5
        cc_i=$((cc_i + 1))
    done
    cc_rest=$(cc_dienste_finden "$1" "$2")
    if [ -n "$cc_rest" ]; then
        kill -9 $cc_rest 2>/dev/null
        sleep 1
        cc_rest=$(cc_dienste_finden "$1" "$2")
    fi
    for cc_p in $cc_rest; do
        CC_UEBRIG="$CC_UEBRIG $cc_p"
    done
}

# Die Deinstallation laeuft als root, der Dienst als loxberry: nur Prozesse
# von loxberry.
CC_UID=$(id -u loxberry 2>/dev/null)
if [ -z "$CC_UID" ]; then
    echo "<WARNING> Benutzer loxberry nicht gefunden - der Dienst wurde nicht gesucht."
else
    cc_dienste_beenden "$BASE/bin/plugins/$PDIR/chromecast4lox_ng-server.py" "$CC_UID"
    if [ -n "$CC_UEBRIG" ]; then
        echo "<WARNING> Der Dienst laesst sich nicht beenden (PID$CC_UEBRIG)."
    elif [ "$CC_GEFUNDEN" != 0 ]; then
        echo "<OK> Dienst beendet ($CC_GEFUNDEN Prozess(e))."
    else
        echo "<INFO> Kein laufender Dienst gefunden."
    fi
fi
rm -f "$PIDDATEI"

# ---------- Den Nachbarn der Sicherung wegraeumen ----------
# data/plugins/<ordner>.upgrade_sicherung liegt AUSSERHALB des Ordners, den
# LoxBerry beim Deinstallieren loescht - genau deshalb uebersteht er ein
# Update. Wer ihn hier nicht abraeumt, laesst Zugangsdaten liegen.
UN_FOLDER="${3:-}"
UN_BASE="${5:-$LBHOMEDIR}"
if [ -n "$UN_FOLDER" ] && [ -n "$UN_BASE" ] && [ -d "$UN_BASE/data/plugins" ]; then
    rm -rf "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung" 2>/dev/null
    # Die Zweitschrift der Einstellungen aus preupgrade.sh. Sie traegt das
    # Aktionstoken; bliebe sie liegen, holte postinstall.sh sie bei einer
    # spaeteren Neuinstallation zurueck (Regeln/06, "Deinstallation").
    CC_ZWEIT="$UN_BASE/config/plugins/$UN_FOLDER.backup.chromecast-4lox-ng.cfg"
    rm -f "$CC_ZWEIT" 2>/dev/null
    if [ -e "$CC_ZWEIT" ]; then
        echo "<WARNING> Die Zweitschrift $CC_ZWEIT liess sich nicht entfernen."
    fi
    # Die Marke aus preupgrade.sh, falls eine Aktualisierung abbrach.
    rm -f "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_laeuft" 2>/dev/null
fi
exit 0
