#!/bin/sh
#
# Chromecast 4 Lox NG - Waechter, alle fuenf Minuten.
#
# Bis 1.2.12 gab es keinen. Starb der Dienst - an einem unerwarteten Fehler
# oder weil ihn jemand beendet hat -, lief er bis zum naechsten Neustart des
# Rechners nicht wieder an. In Loxone sieht das aus wie ein stiller
# Lautsprecher: virtuelle Eingaenge behalten ihren letzten Wert, und niemand
# merkt, dass niemand mehr sendet.
#
# Fuenf Minuten statt einer: der Dienst ist ein Dauerlaeufer, kein Cron-Job.
# Ein minuetlicher Anlauf brauchte nur Rechenzeit.
#
# Die Platzhalter werden bei der Installation ersetzt. Sie stehen deshalb NUR
# in den Zuweisungen und nicht im Kommentar: der Installer ersetzt sie
# ueberall, und danach stuende hier ein fest verdrahteter Systempfad - genau
# danach sucht der Pluginpruefer, ohne den Zusammenhang zu lesen.
#
# NICHT vom eigenen Ablageort eine feste Zahl Ebenen aufwaerts rechnen:
# LoxBerry legt diese Datei unter <Wurzel>/system/cron/cron.05min/<plugin>
# ab. Eine Rechnung mit ".." landet daneben, und der Waechter liefe ins
# Leere, ohne es zu sagen.
DIENST="REPLACELBPBINDIR/chromecast4lox_ng-server.py"
CFG="REPLACELBPCONFIGDIR/chromecast-4lox-ng.cfg"
LOG="REPLACELBPLOGDIR/REPLACELBPPLUGINDIR.log"
# Die Startdatei (seit 1.3.13, C12): in <plugin>.log schreibt allein der
# Dienst selbst; hierher geht nur, was vor seinem Protokoll scheitert.
STARTLOG="REPLACELBPLOGDIR/REPLACELBPPLUGINDIR_start.log"
PIDDATEI="REPLACELBPDATADIR/dienst.pid"
# Die gemeinsame Startsperre mit daemon/daemon (seit 1.3.13, I1/C7).
SPERRE="REPLACELBPDATADIR.startsperre"

# Die eigene Fehlerausgabe sichern. Der Cron des LoxBerry ruft jede Datei
# als "($f cron=05min > /dev/null 2>&1 &)" auf - am Geraet gemessen in
# /etc/cron.d/lbdefaults. Was dieses Skript auf die Fehlerausgabe schreibt,
# waere sonst fort, und im Reiter Logdateien stuende nichts.
#
# Den Ordner vorher anlegen. "exec" ist ein besonderer eingebauter Befehl:
# scheitert seine Umlenkung, beendet sich die Schale sofort - der Waechter
# haette dann gar nichts getan. Der Protokollordner liegt auf der Ramdisk und
# kann nach einem Neustart fehlen. In WSL gemessen (17.09.2026, Fall q8):
# ohne den Ordner endete dieses Skript mit Rueckgabewert 2, ohne eine einzige
# Zeile auszufuehren, und der Dienst blieb aus. Dieselbe Bauart steht in
# Regeln/06 fuer den Abfahrts-Assistenten 1.6.10; dort kam heraus, dass ein
# blosses Anhaengen die Aenderungszeit nicht auffrischt - deshalb "touch",
# damit die stuendliche Logwartung die Datei nicht wegraeumt.
#
# Seit 1.3.13 steht das HINTER der Frage nach dem Schalter (I2): ein
# ausgeschaltetes Plugin legt beim Boot keinen Protokollordner mehr an, in den
# der daemon als root dann eine Datei legt, die root gehoert (in WSL gemessen
# 30.09.2026, Installer-Befund 2).

# Ist das Plugin ausgeschaltet, hat der Waechter nichts zu tun. Sonst
# startete er einen Dienst nach, den der Anwender im Reiter Test bewusst
# angehalten hat - und ein Waechter, der gegen den Willen des Anwenders
# arbeitet, ist schlimmer als keiner.
#
# Der Knopf "Dienst anhalten" setzt enabled=0, "Dienst neu starten" setzt es
# wieder auf 1. Ohne diese Kopplung waere der Haltebefehl nach spaetestens
# fuenf Minuten wirkungslos gewesen.
if [ -f "$CFG" ] && grep -q '^enabled=0' "$CFG"; then
    exit 0
fi

mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
touch "REPLACELBPLOGDIR/cron.err" 2>/dev/null
exec 2>>"REPLACELBPLOGDIR/cron.err"

# Waehrend einer Aktualisierung nichts starten. preupgrade.sh legt die
# Marke neben den Datenordner, postroot.sh entfernt sie nach dem
# Dienststart. Bis 1.3.9 gab es sie nicht: der Installer legt diese Datei
# lange vor postroot.sh neu an, und ein Lauf in dieser Luecke startete den
# Dienst mit der mitgelieferten Vorgabe-Konfiguration (in WSL nachgestellt
# am 17.09.2026). Nur eine Marke, die hoechstens eine Stunde alt ist,
# zaehlt. Aelter, aus der Zukunft oder unlesbar: eine abgebrochene
# Installation hat sie liegen lassen, und der Dienst darf nicht fuer immer
# stillstehen.
MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$MARKE" ]; then
    SEIT=$(cat "$MARKE" 2>/dev/null)
    case "$SEIT" in
        ''|*[!0-9]*) SEIT=0 ;;
    esac
    # Die Uhr wird gemessen, nicht angenommen. Liefert "date" nichts -
    # unter Last kann ein fork scheitern -, dann rechnet die Schale mit einer
    # leeren Zeichenkette: das Alter wird negativ, die Bedingung faellt durch,
    # und der Waechter startete den Dienst MITTEN in der Aktualisierung.
    # (Der alte Ausdruck ist hier absichtlich nicht abgeschrieben - ein
    # Kommentar darf nicht die Zeichenfolge enthalten, nach der ein Werkzeug
    # den Bestand absucht, Regeln/02.) Ein Schutz faellt
    # geschlossen aus (Regeln/01): ohne Uhr wird nicht gestartet, die Marke
    # gilt. Anlass: ein einzelner Lauf des Falls k5a am 17.09.2026 startete
    # trotz liegender Marke; die Ursache ist NICHT belegt, dies ist der
    # einzige Weg im Block, der offen ausfaellt, und er ist jetzt zu.
    JETZT=$(date +%s 2>/dev/null)
    case "$JETZT" in
        ''|*[!0-9]*) JETZT="" ;;
    esac
    if [ -z "$JETZT" ]; then
        exit 0
    fi
    ALTER=$(( JETZT - SEIT ))
    # Bis 300 s "Zukunft" gilt die Marke: eine nachgestellte Uhr ist keine
    # Luege (Muster 8 der Nachlese, Bauart Sprachsteuerung 0.11.9; die
    # Oberflaeche rechnet in cc_upgrade_laeuft() schon so). Bis 1.3.11 fiel
    # eine Marke mit einem Zeitpunkt knapp in der Zukunft hier durch, und der
    # Dienst startete mitten in der Aktualisierung (in WSL gemessen
    # 25.09.2026, Pruefung-Chromecast4lox-1.3.12, Faelle Z1/Z2).
    if [ "$ALTER" -ge -300 ] && [ "$ALTER" -lt 3600 ]; then
        exit 0
    fi
fi

# ---------- Prozesse des Dienstes finden ----------
# Ein Treffer hat GENAU zwei Argumente: einen python-Interpreter und den
# vollen Dienstpfad DIESES Plugins ($1). Dazu muss der Prozess dem Benutzer
# mit der Nummer $2 gehoeren. Ein Editor oder "tail" auf die Datei, eine
# Suche mit dem Namen im Muster und der Dienst eines anderen Plugin-Ordners
# treffen damit nicht. "pgrep -f" traf jede Befehlszeile, in der die
# Zeichenkette irgendwo vorkam.
cc_dienste_finden() {
    for cc_d in /proc/[0-9]*; do
        grep -qaF "chromecast4lox_ng-server.py" "$cc_d/cmdline" 2>/dev/null || continue
        [ "$(stat -c %u "$cc_d" 2>/dev/null)" = "$2" ] || continue
        cc_n=0
        cc_treffer=0
        while IFS= read -r cc_arg; do
            cc_n=$((cc_n + 1))
            if [ "$cc_n" = 1 ]; then
                case "${cc_arg##*/}" in
                    python|python3|python3.*) ;;
                    *) break ;;
                esac
            elif [ "$cc_n" = 2 ] && [ "$cc_arg" = "$1" ]; then
                cc_treffer=1
            fi
        done <<CC_ARGUMENTE
$(tr '\0' '\n' < "$cc_d/cmdline" 2>/dev/null)
CC_ARGUMENTE
        if [ "$cc_treffer" = 1 ] && [ "$cc_n" = 2 ]; then
            echo "${cc_d#/proc/}"
        fi
    done
}

# Fail loud statt still. Ein Waechter, der schweigend nichts tut, ist
# schlimmer als keiner.
if [ ! -x "$DIENST" ]; then
    MELDUNG="Chromecast 4 Lox NG: der Waechter findet chromecast4lox_ng-server.py nicht - es wird nicht nachgestartet."
    command -v logger >/dev/null 2>&1 && logger -t chromecast_4lox_ng "$MELDUNG"
    echo "$MELDUNG" >&2
    exit 1
fi

# Startsperre (seit 1.3.13, I1/C7): Pruefen und Starten unter EINER Sperre
# mit daemon/daemon. Bis 1.3.12 gab es keine: zwei Waechterlaeufe in derselben
# Sekunde (cron holt nach dem Uhrsprung beim Boot nach) ergaben 10 von 10
# Runden zwei Dienste, daemon und zwei Waechter 20 von 20 Runden drei (in WSL
# gemessen 30.09.2026, Code-Befund 7, Installer-Befund 1). Wer spaeter kommt,
# wartet bis 15 s und sieht dann den eben gestarteten. Der Dienst erbt den
# Deskriptor NICHT (9<&- beim Start). Die Datei bleibt liegen; uninstall
# raeumt sie ab.
if [ ! -e "$SPERRE" ]; then
    : > "$SPERRE" 2>/dev/null
fi
if command -v flock >/dev/null 2>&1 && [ -r "$SPERRE" ]; then
    exec 9<"$SPERRE"
    flock -w 15 9 || exit 0
fi

# Laeuft er schon? Argumentweise gesucht, nicht ueber
# "pgrep -f chromecast4lox_ng-server": das traefe auch einen offenen Editor,
# ein Sicherungsskript - und den Dienst eines zweiten Plugin-Ordners.
#
# Die PID-Datei bleibt die erste Frage, aber sie reicht nicht: beim Upgrade
# loescht purge_installation sie mit data/plugins/<ordner>/. Ein Dienst, der
# das Update ueberlebt hatte, war danach unsichtbar, und dieser Waechter
# startete einen zweiten - zwei Dienste auf demselben UDP-Port (in WSL
# gemessen 17.09.2026, Fall q3: nach dem Waechterlauf zwei statt einem).
CC_UID=$(id -u loxberry 2>/dev/null)
[ -n "$CC_UID" ] || CC_UID=$(id -u 2>/dev/null)
CC_LAEUFT=$(cc_dienste_finden "$DIENST" "$CC_UID")

# Mehr als einer? Alle bis auf den aeltesten beenden (seit 1.3.13, C7). Bis
# 1.3.12 trug dieser Waechter nur die PID des ersten nach und liess die
# uebrigen laufen - bis zum naechsten Neustart (in WSL gemessen 30.09.2026,
# Installer-Befund 1: der naechste Takt liess es bei drei). Der aelteste ist
# der mit der kleinsten Startzeit (Feld 22 in /proc/<pid>/stat).
CC_ANZAHL=$(printf '%s\n' "$CC_LAEUFT" | grep -c .)
if [ "$CC_ANZAHL" -gt 1 ]; then
    CC_BLEIBT=""
    CC_BLEIBT_ZEIT=""
    for CC_P in $CC_LAEUFT; do
        CC_Z=$(awk '{print $22}' "/proc/$CC_P/stat" 2>/dev/null)
        case "$CC_Z" in ''|*[!0-9]*) continue ;; esac
        if [ -z "$CC_BLEIBT_ZEIT" ] || [ "$CC_Z" -lt "$CC_BLEIBT_ZEIT" ]; then
            CC_BLEIBT=$CC_P
            CC_BLEIBT_ZEIT=$CC_Z
        fi
    done
    [ -n "$CC_BLEIBT" ] || CC_BLEIBT=$(printf '%s\n' "$CC_LAEUFT" | head -1)
    CC_WEG=""
    for CC_P in $CC_LAEUFT; do
        [ "$CC_P" = "$CC_BLEIBT" ] || CC_WEG="$CC_WEG $CC_P"
    done
    kill $CC_WEG 2>/dev/null
    CC_I=0
    while [ "$CC_I" -lt 20 ]; do
        CC_LEBT=0
        for CC_P in $CC_WEG; do
            kill -0 "$CC_P" 2>/dev/null && CC_LEBT=1
        done
        [ "$CC_LEBT" = 0 ] && break
        sleep 0.5
        CC_I=$((CC_I + 1))
    done
    for CC_P in $CC_WEG; do
        kill -0 "$CC_P" 2>/dev/null && kill -9 "$CC_P" 2>/dev/null
    done
    echo "$CC_BLEIBT" > "$PIDDATEI"
    MELDUNG="Chromecast 4 Lox NG: es liefen $CC_ANZAHL Dienste - beendet:$CC_WEG, es bleibt PID $CC_BLEIBT."
    command -v logger >/dev/null 2>&1 && logger -t chromecast_4lox_ng "$MELDUNG"
    echo "$MELDUNG" >&2
    exit 0
fi

if [ -f "$PIDDATEI" ]; then
    P=$(cat "$PIDDATEI" 2>/dev/null)
    case "$P" in
        ''|*[!0-9]*) P="" ;;
    esac
    if [ -n "$P" ] && echo "$CC_LAEUFT" | grep -qx "$P"; then
        exit 0
    fi
fi
if [ -n "$CC_LAEUFT" ]; then
    # Er laeuft, nur ohne (gueltige) PID-Datei. Nachtragen statt nachstarten,
    # damit die Oberflaeche und der naechste Lauf ihn wiederfinden.
    CC_ERSTE=$(echo "$CC_LAEUFT" | head -1)
    CC_ANZAHL=$(echo "$CC_LAEUFT" | grep -c .)
    mkdir -p "$(dirname "$PIDDATEI")" 2>/dev/null
    echo "$CC_ERSTE" > "$PIDDATEI"
    MELDUNG="Chromecast 4 Lox NG: der Dienst lief ohne gueltige PID-Datei ($CC_ANZAHL Prozess(e), PID $CC_ERSTE). Die PID-Datei wurde nachgetragen; es wurde kein zweiter gestartet."
    command -v logger >/dev/null 2>&1 && logger -t chromecast_4lox_ng "$MELDUNG"
    exit 0
fi

# Er laeuft nicht. Nachstarten.
#
# NICHT ueber "su loxberry -c". Bis 1.3.6 stand hier genau das, und der
# Waechter hat damit nie einen Dienst nachgestartet. Am Geraet gemessen am
# 06.09.2026: /etc/cron.d/lbdefaults ruft jede Datei unter cron.05min
# bereits ALS loxberry auf -
#
#     */5 * * * * loxberry cd / && for f in .../cron.05min/*; do ($f &); done
#
# und "su" auf denselben Benutzer verlangt trotzdem root:
#
#     su loxberry -c "echo x"   ->   su: Authentication failure   rc=1
#
# Der Benutzer wird deshalb GEMESSEN, nicht angenommen. Der su-Weg bleibt
# fuer den Fall, dass wirklich root aufruft - Handprobe oder ein fremder
# Cron. Dann, und nur dann, stimmt er.
mkdir -p "$(dirname "$PIDDATEI")" 2>/dev/null
# Laeuft dieses Skript ausnahmsweise als root - Handprobe oder ein fremder
# Cron -, gehoert der eben angelegte Ordner root, und der Dienst koennte
# nicht mehr hineinschreiben. Deshalb gleich uebergeben; als loxberry ist der
# Block wirkungslos und wird uebersprungen.
if [ "$(id -u 2>/dev/null)" = "0" ]; then
    chown loxberry:loxberry "$(dirname "$PIDDATEI")" 2>/dev/null
    chown loxberry:loxberry "$(dirname "$LOG")" 2>/dev/null
fi
WER=$(id -un 2>/dev/null)
if [ "$WER" = "loxberry" ]; then
    # 'echo $!' unmittelbar nach dem Abzweigen: das ist die Nummer des
    # Dienstes selbst. "9<&-": der Dienst erbt die Startsperre nicht.
    nohup "$DIENST" >> "$STARTLOG" 2>&1 9<&- &
    echo $! > "$PIDDATEI"
elif [ "$(id -u 2>/dev/null)" = "0" ]; then
    # Hier muss 'echo $!' INNERHALB der su-Zeichenkette stehen: draussen
    # waere es die Nummer des su-Prozesses, und der beendet sich sofort.
    chown loxberry:loxberry "$LOG" "$STARTLOG" 2>/dev/null
    su loxberry -c "nohup '$DIENST' >> '$STARTLOG' 2>&1 9<&- & echo \$! > '$PIDDATEI'" >/dev/null 2>&1 9<&-
    chown loxberry:loxberry "$PIDDATEI" "$STARTLOG" 2>/dev/null
else
    MELDUNG="Chromecast 4 Lox NG: der Waechter laeuft als '$WER' - weder loxberry noch root. Es wird nicht nachgestartet."
    command -v logger >/dev/null 2>&1 && logger -t chromecast_4lox_ng "$MELDUNG"
    echo "$MELDUNG" >&2
    exit 1
fi

# Die WIRKUNG messen, nicht den Rueckgabewert.
#
# "nohup ... &" endet IMMER mit 0 - die Schale meldet, dass sie abgezweigt
# hat, nicht dass das Programm lebt. Die alte Fassung leitete genau daraus
# ihre Erfolgsmeldung ab; sie haette "nachgestartet" auch dann gemeldet,
# wenn der Dienst nach einer Zehntelsekunde am fehlenden pychromecast
# gestorben waere.
#
# Der Dienst baut beim Start eine MQTT-Verbindung auf und sucht im Netz.
# Drei Sekunden reichen, um zu sehen, ob er ueberhaupt steht.
sleep 3
NEU=$(cat "$PIDDATEI" 2>/dev/null)
case "$NEU" in
    ''|*[!0-9]*) NEU="" ;;
esac
if [ -n "$NEU" ] && kill -0 "$NEU" 2>/dev/null \
   && tr '\0' '\n' < "/proc/$NEU/cmdline" 2>/dev/null \
      | sed 's#.*/##' | grep -qx "chromecast4lox_ng-server.py"; then
    # Im Normalfall schweigt dieses Skript. Nur der Nachstart selbst ist eine
    # Zeile wert - sonst schriebe ein Cron alle fuenf Minuten in den
    # Systemlogger, und niemand laese ihn mehr.
    MELDUNG="Chromecast 4 Lox NG: der Dienst lief nicht mehr und wurde nachgestartet (PID $NEU)."
    command -v logger >/dev/null 2>&1 && logger -t chromecast_4lox_ng "$MELDUNG"
    exit 0
fi

MELDUNG="Chromecast 4 Lox NG: der Dienst liess sich nicht nachstarten - siehe Reiter Logdateien."
command -v logger >/dev/null 2>&1 && logger -t chromecast_4lox_ng "$MELDUNG"
echo "$MELDUNG" >&2
exit 1
